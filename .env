####
# Front-end environment variables must follow the conventions described in https://vite.dev/guide/env-and-mode
####

VITE_APP_API_BASE_URL=''
VITE_APP_DEBUG=false

# Devs debugging Google Analytics integration should set the following config in their .env.development.local file.
# In AWS environments, this ID is kept in python configs (e.g, boa-dev.py) and injected into env.local by 01_download_local_configs.sh.
VITE_APP_GOOGLE_ANALYTICS_ID=''
